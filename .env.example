# Server Configuration
PORT=3000

# Authentication
# JWT_SECRET must be at least 32 bytes long for HS256 algorithm security
JWT_SECRET=replace-with-a-secure-jwt-secret-at-least-32-bytes-long

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tasks_db
